{
  "framework": "nextjs",
  "ignoreCommand": "case "$VERCEL_GIT_COMMIT_REF" in dependabot/*) exit 0 ;; *) exit 1 ;; esac",
  "installCommand": "npx --yes pnpm@10.12.4 install --no-frozen-lockfile",
  "buildCommand": "npx --yes pnpm@10.12.4 --filter @attention-firewall/web... build",
  "devCommand": "npx --yes pnpm@10.12.4 --filter @attention-firewall/web dev"
}
