# Server-only variables. Never prefix secrets with NEXT_PUBLIC_.

# Optional for the local-first experience; required for account/passkey/cloud-sync routes.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/attention_firewall"

# At least 32 random characters. Store in Vercel as a sensitive variable.
AUTH_FLOW_SECRET="replace-with-a-32-plus-character-random-secret"

# WebAuthn relying-party configuration.
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:3000"
