<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/af_ink">
    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="ATTENTION FIREWALL"
            android:textColor="@color/af_bone"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/status"
            android:textColor="@color/af_muted"
            android:textSize="15sp"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/grantUsage"
            android:text="Grant usage access"
            android:layout_marginTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/prepareLauncher"
            android:text="Prepare launcher mode (no takeover)"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Protection mode"
            android:textColor="@color/af_gold"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <RadioGroup
            android:id="@+id/protectionMode"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton android:id="@+id/modeStandard" android:text="Standard — gentle awareness" android:textColor="@color/af_bone" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <RadioButton android:id="@+id/modeFocus" android:text="Focus — redirect when drift rises" android:textColor="@color/af_bone" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <RadioButton android:id="@+id/modeDeepFocus" android:text="Deep Focus — automatic productive redirect after sustained drift" android:textColor="@color/af_bone" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <RadioButton android:id="@+id/modeRecovery" android:text="Recovery — prioritize leaving the loop" android:textColor="@color/af_bone" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </RadioGroup>

        <EditText
            android:id="@+id/nextTaskCue"
            android:hint="Optional next task cue for local redirection"
            android:textColor="@color/af_bone"
            android:textColorHint="@color/af_muted"
            android:singleLine="true"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/saveRedirection"
            android:text="Save redirection preferences locally"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/hardProtection"
            android:text="Open Hard Protection settings"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <CheckBox
            android:id="@+id/hardLock"
            android:text="Hard Lock selected apps"
            android:textColor="#FFFFFF"
            android:layout_marginTop="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Select protected apps"
            android:textColor="@color/af_gold"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/appList"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/saveProtected"
            android:text="Save protected apps locally"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/sample"
            android:text="Run local usage sample"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Attention Firewall does not read screen content. Protected app choices and policy remain on this device."
            android:textColor="@color/af_muted"
            android:textSize="12sp"
            android:layout_marginTop="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
